<?xml version="1.0" encoding="utf-8"?>
<!--
  Multicam launcher icon foreground.

  Design: four viewfinder/frame corner brackets (representing multiple
  cameras being framed/controlled at once) in the app's accent blue,
  with a solid red dot in the center representing an active recording
  (REC indicator), matching the control page's REC badge style.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- top-left corner -->
    <path
        android:pathData="M30,42 L30,30 L42,30"
        android:strokeColor="#3B82F6"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- top-right corner -->
    <path
        android:pathData="M66,30 L78,30 L78,42"
        android:strokeColor="#3B82F6"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- bottom-right corner -->
    <path
        android:pathData="M78,66 L78,78 L66,78"
        android:strokeColor="#3B82F6"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- bottom-left corner -->
    <path
        android:pathData="M42,78 L30,78 L30,66"
        android:strokeColor="#3B82F6"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- REC dot -->
    <path
        android:pathData="M54,54 m-14,0 a14,14 0 1,0 28,0 a14,14 0 1,0 -28,0"
        android:fillColor="#E74C3C" />
</vector>
