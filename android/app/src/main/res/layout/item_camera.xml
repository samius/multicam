<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#16181D"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:id="@+id/recDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/dot_gray" />

        <TextView
            android:id="@+id/camName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#E8E8EA"
            android:textStyle="bold"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/camAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8A8F98"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/camStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#8A8F98"
        android:textSize="12sp"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/camStartButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#2ECC71"
            android:textSize="13sp"
            android:text="▶ Start" />

        <Button
            android:id="@+id/camStopButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:backgroundTint="#E74C3C"
            android:textSize="13sp"
            android:text="■ Stop" />
    </LinearLayout>
</LinearLayout>
